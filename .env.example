# =============================================================================
# MONTEIRO VELOSO — VARIÁVEIS DE AMBIENTE
#
# Este arquivo é um TEMPLATE. Copie para .env.local e preencha.
# O .env.local não vai para o Git.
#
# Aqui ficam apenas as variáveis do Supabase e do app.
# Chaves privadas das integrações (ZapSign, Asaas, Google Drive, Infinitum,
# Vertisell e e-mail) estão em docs/functions.md e vão para Supabase Secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SUPABASE — FRONTEND (público, pode ir para o bundle)
#
# Onde encontrar:
#   Supabase Dashboard → Project Settings → API
#
# VITE_SUPABASE_URL      = Project URL (não é a URL do REST)
# VITE_SUPABASE_ANON_KEY = Publishable key (sb_publishable_...)
#                          ou a legacy anon key
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# 2. APLICAÇÃO (Vite)
#
# VITE_APP_URL  = URL pública do formulário.
#                 Local: http://localhost:5173
#                 Produção: https://form.monteiroveloso.com
#
# VITE_API_MODE = mock  → sem backend (demonstração)
#                 http  → usa as Edge Functions do Supabase
#
# VITE_EMAIL_CONFIRMATION = true → mostra na tela final que um e-mail foi
#                 enviado. Só habilite com EMAIL_MODE=live nas funções.
# -----------------------------------------------------------------------------
VITE_APP_URL=http://localhost:5173
VITE_API_MODE=mock
# VITE_EMAIL_CONFIRMATION=false


# -----------------------------------------------------------------------------
# 3. SUPABASE — CLI / DEPLOY (NÃO colocar no frontend)
#
# Use no terminal ou no CI. O Vite não lê estas variáveis.
#
# Onde encontrar:
#   SUPABASE_ACCESS_TOKEN = Supabase Dashboard → Account → Access Tokens
#   SUPABASE_PROJECT_REF  = Project Settings → General (Reference ID)
#   SUPABASE_DB_PASSWORD  = Project Settings → Database (senha do banco)
# -----------------------------------------------------------------------------
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=


# -----------------------------------------------------------------------------
# 4. SUPABASE — EDGE FUNCTIONS
#
# O runtime do Supabase injeta estas variáveis automaticamente.
# Só preencha/cadastre manualmente se o ambiente exigir:
#   Project Settings → Edge Functions → Secrets
#
# Nunca coloque SUPABASE_SERVICE_ROLE_KEY no frontend: ela ignora RLS.
# -----------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=


# =============================================================================
# FORA DO ESCOPO DESTE ARQUIVO
#
# Turnstile, ZapSign, Asaas, Google Drive, Infinitum, Vertisell e e-mail:
# veja docs/functions.md e docs/integrations/resend.md.
#
# Resumo de onde colar:
#   Vercel  → VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_APP_URL,
#             VITE_API_MODE, VITE_TURNSTILE_SITE_KEY, VITE_EMAIL_CONFIRMATION
#   Supabase Secrets → todas as chaves privadas das integrações
# =============================================================================
